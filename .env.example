# Telegram Bot Token (lấy từ @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram User ID của bạn (lấy từ @userinfobot)
OWNER_ID=your_user_id_here

# Thời gian kiểm tra mặc định (giây)
DEFAULT_INTERVAL=60

# MongoDB connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=MyApp
MONGO_DB_NAME=testflight_monitor

# Timeout khi gọi HTTP (giây)
REQUEST_TIMEOUT=15
